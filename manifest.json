{
  "manifest_version": 3,
  "name": "Signalbox — GitHub Notifications Triage & AI Summaries",
  "version": "1.4.0",
  "minimum_chrome_version": "120",
  "description": "Turn GitHub's notification firehose into pure signal with local AI summaries, Priority triage, Subscriptions, and one-click sweep.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Signalbox",
    "default_popup": "manager.html?popup=1"
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["core.js", "summary.js", "store.js", "dom.js", "preview.js", "summary-client.js", "scanner.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
